              "name": "401 Unauthorized",
              "originalRequest": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] } },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"message\": \"Invalid email or password\"\n}"
            }
          ]
        },
        {
          "name": "Login - missing password (400)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "response": [
            {
              "name": "400 Bad Request",
              "originalRequest": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] } },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"message\": \"Email and password are required\"\n}"
            }
          ]
        },
        {
          "name": "Login - NoSQL injection (400)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": { \"$gt\": \"\" },\n  \"password\": { \"$gt\": \"\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Operator keys are stripped by express-mongo-sanitize and the values fail the string check, so the query never runs."
          },
          "response": [
            {
              "name": "400 Bad Request",
              "originalRequest": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] } },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"message\": \"Email and password are required\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Forms",
      "item": [
        {
          "name": "Create form",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "if (body._id) {",
                  "  pm.collectionVariables.set('formId', body._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Customer Registration\",\n  \"description\": \"Tell us a little about yourself.\",\n  \"status\": \"published\",\n  \"fields\": [\n    { \"key\": \"firstName\", \"label\": \"First Name\", \"type\": \"text\", \"placeholder\": \"Enter your first name\", \"required\": true, \"minLength\": 2, \"maxLength\": 50 },\n    { \"key\": \"email\", \"label\": \"Email\", \"type\": \"email\", \"placeholder\": \"name@company.com\", \"required\": true },\n    { \"key\": \"gender\", \"label\": \"Gender\", \"type\": \"select\", \"required\": true, \"options\": [\"Male\", \"Female\", \"Other\"] },\n    { \"key\": \"mobile\", \"label\": \"Mobile\", \"type\": \"phone\", \"placeholder\": \"+91 98765 43210\", \"required\": true },\n    { \"key\": \"age\", \"label\": \"Age\", \"type\": \"number\", \"min\": 18, \"max\": 99 },\n    { \"key\": \"interests\", \"label\": \"Interests\", \"type\": \"checkbox\", \"options\": [\"Product updates\", \"Events\", \"Offers\"] }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/forms", "host": ["{{baseUrl}}"], "path": ["forms"] },
            "description": "Creates a form. `status` is `draft` (default) or `published`. If `fields` is left out, the form starts with the starter fields. The test script saves the new id to `formId`."
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/forms", "host": ["{{baseUrl}}"], "path": ["forms"] } },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"name\": \"Customer Registration\",\n  \"description\": \"Tell us a little about yourself.\",\n  \"status\": \"published\",\n  \"fields\": [\n    { \"key\": \"firstName\", \"label\": \"First Name\", \"type\": \"text\", \"placeholder\": \"Enter your first name\", \"defaultValue\": null, \"required\": true, \"minLength\": 2, \"maxLength\": 50 },\n    { \"key\": \"email\", \"label\": \"Email\", \"type\": \"email\", \"placeholder\": \"name@company.com\", \"defaultValue\": null, \"required\": true },\n    { \"key\": \"gender\", \"label\": \"Gender\", \"type\": \"select\", \"placeholder\": \"\", \"defaultValue\": null, \"required\": true, \"options\": [\"Male\", \"Female\", \"Other\"] },\n    { \"key\": \"mobile\", \"label\": \"Mobile\", \"type\": \"phone\", \"placeholder\": \"+91 98765 43210\", \"defaultValue\": null, \"required\": true },\n    { \"key\": \"age\", \"label\": \"Age\", \"type\": \"number\", \"placeholder\": \"\", \"defaultValue\": null, \"required\": false, \"min\": 18, \"max\": 99 },\n    { \"key\": \"interests\", \"label\": \"Interests\", \"type\": \"checkbox\", \"placeholder\": \"\", \"defaultValue\": null, \"required\": false, \"options\": [\"Product updates\", \"Events\", \"Offers\"] }\n  ],\n  \"createdBy\": \"6b05ae38801c7580526b1f4f\",\n  \"publishedAt\": \"2026-11-25T09:12:44.120Z\",\n  \"_id\": \"6b0c1f2a9e4d3b0012a4c7e1\",\n  \"createdAt\": \"2026-11-25T09:12:44.120Z\",\n  \"updatedAt\": \"2026-11-25T09:12:44.120Z\"\n}"
            }
          ]
        },
