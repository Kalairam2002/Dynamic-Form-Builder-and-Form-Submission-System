{
  "info": {
    "name": "Form Builder API",
    "description": "API collection for the Dynamic Form Builder.\n\nHow to use:\n1. Start the API (`cd server && npm run dev`).\n2. In the collection Variables tab, set `adminEmail` and `adminPassword` to the values used with `npm run seed:admin`.\n3. Run **Auth > Login** first. It saves the token to `token`.\n4. Run the requests from top to bottom. **Create form** saves `formId` and **Submit (valid)** saves `submissionId`.\n\nAdmin requests inherit Bearer auth from the collection. Public requests are set to No Auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "adminEmail", "value": "admin@example.com", "type": "string" },
    { "key": "adminPassword", "value": "", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "formId", "value": "", "type": "string" },
    { "key": "submissionId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Returns ok when the API is running."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"status\": \"ok\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "  pm.collectionVariables.set('token', body.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Logs in the admin and returns a JWT. The test script saves it to the `token` variable.\n\nRate limit: 10 failed attempts per 15 minutes per IP."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"YourPassword123\"\n}" }, "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI2YjA1YWUzODgwMWM3NTgwNTI2YjFmNGYiLCJyb2xlIjoiYWRtaW4iLCJpYXQiOjE3OTQwNTk2MDAsImV4cCI6MTc5NDE0NjAwMH0.p6d3M0YxQw2r9yV7mJbK1nL4sT8uE5aZcH0gXfRiWqo\",\n  \"user\": {\n    \"_id\": \"6b05ae38801c7580526b1f4f\",\n    \"name\": \"Admin\",\n    \"email\": \"admin@example.com\",\n    \"role\": \"admin\",\n    \"createdAt\": \"2026-11-24T15:33:12.573Z\",\n    \"updatedAt\": \"2026-11-24T15:33:12.573Z\"\n  }\n}"
            },
            {
              "name": "429 Too many attempts",
              "originalRequest": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] } },
              "status": "Too Many Requests",
              "code": 429,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"message\": \"Too many login attempts, please try again in 15 minutes\"\n}"
            }
          ]
        },
        {
          "name": "Login - wrong password (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "The same message is returned for an unknown email, so the API does not reveal which emails exist."
